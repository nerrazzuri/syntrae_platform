NODE_ENV=development
BASE_URL=https://app.localhost.com:8443
API_BASE_URL=/api
AI_CORE_URL=http://ai-core:8000

POSTGRES_PASSWORD=local_dev_password
DATABASE_URL=postgresql://superuser:local_dev_password@postgresql:5432/syntrae_core
JWT_SECRET=local-dev-jwt-secret-change-me
AI_CORE_INTERNAL_SECRET=local-dev-internal-secret
AI_ENGAGEMENT_INTERNAL_SECRET=local-dev-engagement-secret
CORS_ALLOWED_ORIGINS=https://app.localhost.com:8443,https://api.localhost.com:8443

# Optional for real AI evaluation. Leave blank for UI/API/database flow testing.
OPENAI_API_KEY=
LOCAL_OPENAI_API_KEY=

BETA_SIGNUP_ENABLED=true
BETA_SIGNUP_ALLOWLIST=
BILLING_MANUAL_PLAN_CHANGES=1
ADMIN_BOOTSTRAP_EMAIL=admin@localhost.test
ADMIN_BOOTSTRAP_PASSWORD=admin12345
XHS_SESSION_ENCRYPTION_KEY=local-dev-xhs-session-key
AUTOMATION_MAX_CONCURRENT_JOBS=1

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Syntrae Local
SMTP_FROM_EMAIL=local@syntrae.test

PROXY_ENABLED=false
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
HOME=.
