// =====================================
// Prisma schema — Engagement Service
// ALL TABLES live in schema: engagement
// =====================================

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core"]
}

model Account {
  id                String   @id @default(uuid())
  status            String   @default("ACTIVE")
  name              String   @default("My Workspace")
  plan_id           String   @default("STARTER")
  onboarding_state  String   @default("CREATED")
  created_at        DateTime @default(now())

  installs           InstallRegistry[]
  events             EngagementEvent[]
  memberships        WorkspaceMembership[]
  active_sessions    Session[]
  owner_settings     OwnerSettings?
  platform_connections BrandPlatformConnection[]
  platform_connection_challenges PlatformConnectionChallenge[]

  suggestions        Suggestion[]
  decisions          SuggestionDecision[]
  leads              LeadOpportunity[]
  brands             Brand[]

  @@schema("core")
}

model Brand {
  id              String   @id @default(uuid())
  workspace_id    String
  name            String
  domain          String
  domain_context  Json
  status          String   @default("ACTIVE") // ACTIVE, PAUSED
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  account         Account  @relation(fields: [workspace_id], references: [id])
  
  // Relations
  events          EngagementEvent[]
  leads           LeadOpportunity[]
  drafts          OutreachDraft[]
  platform_connections BrandPlatformConnection[]
  platform_connection_challenges PlatformConnectionChallenge[]

  @@index([workspace_id])
  @@schema("core")
}

model BrandPlatformConnection {
  id                 String   @id @default(uuid())
  workspace_id       String
  brand_id           String
  platform           String
  provider           String   @default("MANUAL_SESSION")
  auth_type          String   @default("MANUAL_SESSION_FILE")
  status             String   @default("DISCONNECTED")
  session_path       String?
  encrypted_session_payload String?
  session_version    Int      @default(1)
  session_updated_at DateTime?
  connected_at       DateTime?
  last_checked_at    DateTime?
  last_verified_at   DateTime?
  verification_error String?
  expires_at         DateTime?
  last_error         String?
  metadata           Json     @default("{}")
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  account Account @relation(fields: [workspace_id], references: [id])
  brand   Brand   @relation(fields: [brand_id], references: [id])

  @@unique([brand_id, platform])
  @@index([workspace_id, platform, status])
  @@schema("core")
}

model PlatformConnectionChallenge {
  id              String   @id @default(uuid())
  workspace_id    String
  brand_id        String
  platform        String
  nonce_hash      String
  expires_at      DateTime
  used_at         DateTime?
  created_by_user_id String
  created_at      DateTime @default(now())

  account Account @relation(fields: [workspace_id], references: [id])
  brand   Brand   @relation(fields: [brand_id], references: [id])
  user    User    @relation(fields: [created_by_user_id], references: [id])

  @@index([workspace_id, brand_id, platform])
  @@index([expires_at, used_at])
  @@schema("core")
}

model Suggestion {
  id                        String   @id @default(uuid())
  workspace_id              String
  event_id                  String
  platform                  String
  video_id                  String
  comment_id                String?
  suggested_text            String
  strategy                  String
  confidence                Float
  signals                   String
  owner_settings_snapshot   String
  status                    String   @default("PENDING")
  created_at                DateTime @default(now())
  expires_at                DateTime?
  context_type              String?
  speaker_role              String?
  template_category         String?

  account     Account          @relation(fields: [workspace_id], references: [id])
  event       EngagementEvent  @relation(fields: [event_id], references: [id])
  decisions   SuggestionDecision[]

  automation_eligible        Boolean? @default(false)
  automation_reasons         String?  @default("[]")
  automation_checked_at      DateTime?

  @@index([workspace_id])
  @@index([event_id])
  @@schema("core")
}

model SuggestionDecision {
  id            String   @id @default(uuid())
  suggestion_id String   @unique
  workspace_id  String
  user_id       String
  decision      String
  final_text    String?
  reason        String?
  created_at    DateTime @default(now())

  suggestion  Suggestion @relation(fields: [suggestion_id], references: [id])
  account     Account    @relation(fields: [workspace_id], references: [id])
  user        User       @relation(fields: [user_id], references: [id])

  @@schema("core")
}

model OwnerSettings {
  workspace_id              String   @id
  mode                      String   @default("OBSERVE_ONLY")
  aggressiveness            String   @default("CONSERVATIVE")
  enable_intents            String   @default("{}")
  min_intent_confidence     Float    @default(0.7)
  platforms_enabled         String   @default("[]")
  max_suggestions_per_day   Int      @default(20)
  automation_opt_in         Boolean  @default(false)
  max_suggestions_per_video Int      @default(2)
  cooldown_hours            Int      @default(24)
  reply_qualified_mode      String   @default("MANUAL_REVIEW")
  reply_redirect_target     String   @default("STORE")
  reply_cta_style           String   @default("SOFT")
  reply_require_human_review_high_risk Boolean @default(true)
  auto_reply_confidence_threshold Float @default(0.9)
  preferred_language        String?
  tone                      String?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  account Account @relation(fields: [workspace_id], references: [id])

  @@index([workspace_id])
  @@schema("core")
}

model InstallRegistry {
  id             String   @id @default(uuid())
  install_id     String   @unique
  install_secret String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  account_id String?
  account    Account? @relation(fields: [account_id], references: [id])

  @@index([account_id])
  @@schema("core")
}

model EngagementEvent {
  id                 String   @id @default(uuid())
  external_event_id  String?  @unique
  dedup_key          String   @unique
  semantic_dedup_key String?  @unique
  observed_at        DateTime?
  platform           String
  target_id          String   @default("unknown")

  account_id String?
  account    Account? @relation(fields: [account_id], references: [id])
  install_id String?

  video_id     String?
  comment_id   String?
  content_text String?
  metadata     Json
  status       String
  failure_reason String? // Phase 28.2: Lossless Ingestion Reason
  created_at   DateTime @default(now())

  sessions     SuggestionSession[]
  suggestions  Suggestion[]
  leads        LeadOpportunity[]

  brand_id     String?
  brand        Brand?   @relation(fields: [brand_id], references: [id])

  @@index([account_id])
  @@index([install_id])
  @@index([created_at])
  @@index([brand_id])
  @@index([account_id, platform, video_id, created_at])
  @@schema("core")
}

model SuggestionSession {
  id              String   @id @default(uuid())
  event_id        String
  version         Int      @default(1)
  input_snapshot  String
  suggestion_text String
  brain_meta      String?
  created_at      DateTime @default(now())

  event    EngagementEvent @relation(fields: [event_id], references: [id])
  feedback FeedbackSignal?

  @@schema("core")
}

model FeedbackSignal {
  id             String   @id @default(uuid())
  session_id     String   @unique
  action         String
  final_text     String?
  edit_distance  Int?
  time_to_action Int?
  created_at     DateTime @default(now())

  session SuggestionSession @relation(fields: [session_id], references: [id])

  @@schema("core")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password_hash String
  status         String   @default("ACTIVE")
  created_at     DateTime @default(now())
  email_verified_at DateTime?
  verification_email_sent_at DateTime?

  login_attempts Int      @default(0)
  locked_until   DateTime?
  last_login_at  DateTime?

  memberships WorkspaceMembership[]
  sessions    Session[]
  decisions   SuggestionDecision[]
  action_tokens UserActionToken[]
  platform_connection_challenges PlatformConnectionChallenge[]

  @@schema("core")
}

model UserActionToken {
  id          String   @id @default(uuid())
  user_id     String
  token_hash  String   @unique
  token_type  String
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime @default(now())
  metadata    Json     @default("{}")

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, token_type, expires_at])
  @@schema("core")
}

model AdminUser {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          String   @default("SUPERADMIN")
  created_at    DateTime @default(now())

  sessions AdminSession[]

  @@schema("core")
}

model AdminSession {
  id         String   @id @default(uuid())
  admin_id  String
  expires_at DateTime
  created_at DateTime @default(now())

  admin AdminUser @relation(fields: [admin_id], references: [id])

  @@schema("core")
}

model AuditLog {
  id             String   @id @default(uuid())
  actor_id       String
  actor_type     String
  action         String
  resource       String
  resource_id    String?
  workspace_id   String?
  meta           String?
  ip             String?
  correlation_id String?
  created_at     DateTime @default(now())

  @@index([workspace_id, created_at])
  @@index([actor_id, created_at])
  @@index([correlation_id])
  @@schema("core")
}

model WorkspaceMembership {
  id           String   @id @default(uuid())
  workspace_id String
  user_id      String
  role         String   @default("MEMBER")
  status       String   @default("ACTIVE")
  created_at   DateTime @default(now())

  account Account @relation(fields: [workspace_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@index([workspace_id])
  @@index([user_id])
  @@unique([workspace_id, user_id])
  @@schema("core")
}

model Session {
  id                  String   @id @default(uuid())
  user_id             String
  active_workspace_id String?
  expires_at          DateTime
  last_seen_at        DateTime @default(now())
  created_at          DateTime @default(now())

  user             User     @relation(fields: [user_id], references: [id])
  active_workspace Account? @relation(fields: [active_workspace_id], references: [id])

  @@index([user_id])
  @@index([active_workspace_id])
  @@schema("core")
}

enum BuyerStage {
  AWARENESS
  EVALUATING
  READY

  @@schema("core")
}

enum RecommendedAction {
  SILENT_CAPTURE
  RECOMMEND_DM
  PRIORITY_DM

  @@schema("core")
}

model LeadOpportunity {
  id                String            @id @default(uuid())
  platform          String
  video_id          String
  comment_id        String
  user_handle       String?
  user_profile_url  String?
  intent            String
  buyer_stage       BuyerStage
  confidence        Float
  preferences       Json?
  recommended_action RecommendedAction
  urgency_score     Float             @default(0.0)
  risk_level        String            @default("LOW") // LOW, MEDIUM, HIGH
  source_event_id   String
  account_id        String

  created_at        DateTime          @default(now())

  event             EngagementEvent   @relation(fields: [source_event_id], references: [id])
  account           Account           @relation(fields: [account_id], references: [id])
  drafts            OutreachDraft[]

  brand_id          String?
  brand             Brand?            @relation(fields: [brand_id], references: [id])

  @@unique([platform, comment_id])
  @@index([brand_id])
  @@schema("core")
}

model OutreachDraft {
  id               String   @id @default(uuid())
  lead_id          String
  account_id       String
  platform         String
  buyer_stage      BuyerStage
  tone             String
  language         String
  source_language  String?
  draft_text       String
  edited_text      String?
  generation_meta  Json
  draft_kind       String   @default("PUBLIC_REPLY")
  reply_channel    String   @default("THREAD_REPLY")
  cta_target       String?
  cta_label        String?
  risk_flags       Json     @default("[]")
  delivery_error   String?
  status           String   @default("DRAFT")
  generated_by     String   @default("AI_CORE")
  confidence       Float?
  normalization_version String?
  intent_score     Float?
  approved_by_user_id String?
  approved_at      DateTime?
  sent_at          DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt @default(now())

  lead LeadOpportunity @relation(fields: [lead_id], references: [id])

  brand_id   String?
  brand      Brand?   @relation(fields: [brand_id], references: [id])

  @@index([account_id, created_at])
  @@index([lead_id])
  @@index([brand_id])
  @@schema("core")
}
