// =====================================
// Prisma schema — Engagement Service
// ALL TABLES live in schema: engagement
// =====================================

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core"]
}

model Account {
  id                String   @id @default(uuid())
  status            String   @default("ACTIVE")
  name              String   @default("My Workspace")
  plan_id           String   @default("STARTER")
  onboarding_state  String   @default("CREATED")
  created_at        DateTime @default(now())

  installs           InstallRegistry[]
  events             EngagementEvent[]
  memberships        WorkspaceMembership[]
  active_sessions    Session[]
  owner_settings     OwnerSettings?
  subscription       WorkspaceSubscription?
  usage_counters     WorkspaceUsageCounter[]

  suggestions        Suggestion[]
  decisions          SuggestionDecision[]
  leads              LeadOpportunity[]
  brands             Brand[]

  @@schema("core")
}

model Brand {
  id              String   @id @default(uuid())
  workspace_id    String
  name            String
  domain          String
  domain_context  Json
  status          String   @default("ACTIVE") // ACTIVE, PAUSED
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  account         Account  @relation(fields: [workspace_id], references: [id])
  
  // Relations
  events          EngagementEvent[]
  leads           LeadOpportunity[]
  drafts          OutreachDraft[]
  policies        AutomationPolicy[]
  market_profiles MarketProfile[]
  discovered_videos DiscoveredVideo[]
  usage_counters  WorkspaceUsageCounter[]

  @@index([workspace_id])
  @@schema("core")
}

model WorkspaceSubscription {
  id                     String   @id @default(uuid())
  workspace_id           String   @unique
  plan_code              String
  display_name           String
  billing_provider       String   @default("MANUAL")
  status                 String   @default("ACTIVE")
  billing_interval       String   @default("MONTHLY")
  is_trial               Boolean  @default(false)
  trial_ends_at          DateTime?
  current_period_start   DateTime?
  current_period_end     DateTime?
  cancel_at_period_end   Boolean  @default(false)
  scheduled_plan_code    String?
  stripe_customer_id     String?  @unique
  stripe_subscription_id String?  @unique
  stripe_price_id        String?
  stripe_product_id      String?
  addon_config           Json     @default("{}")
  metadata               Json     @default("{}")
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  account Account @relation(fields: [workspace_id], references: [id])

  @@index([plan_code, status])
  @@schema("core")
}

model WorkspaceUsageCounter {
  id                String   @id @default(uuid())
  workspace_id      String
  brand_id          String?
  scope_key         String
  metric_code       String
  period_type       String
  period_start      DateTime
  current_value     Int      @default(0)
  blocked_at        DateTime?
  block_reason_code String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  account Account @relation(fields: [workspace_id], references: [id])
  brand   Brand?  @relation(fields: [brand_id], references: [id])

  @@unique([workspace_id, scope_key, metric_code, period_type, period_start])
  @@index([workspace_id, metric_code, period_type, period_start])
  @@index([brand_id, metric_code, period_type, period_start])
  @@schema("core")
}

model Suggestion {
  id                        String   @id @default(uuid())
  workspace_id              String
  event_id                  String
  platform                  String
  video_id                  String
  comment_id                String?
  suggested_text            String
  strategy                  String
  confidence                Float
  signals                   String
  owner_settings_snapshot   String
  status                    String   @default("PENDING")
  created_at                DateTime @default(now())
  expires_at                DateTime?
  context_type              String?
  speaker_role              String?
  template_category         String?

  account     Account          @relation(fields: [workspace_id], references: [id])
  event       EngagementEvent  @relation(fields: [event_id], references: [id])
  decisions   SuggestionDecision[]

  automation_eligible        Boolean? @default(false)
  automation_reasons         String?  @default("[]")
  automation_checked_at      DateTime?

  @@index([workspace_id])
  @@index([event_id])
  @@schema("core")
}

model SuggestionDecision {
  id            String   @id @default(uuid())
  suggestion_id String   @unique
  workspace_id  String
  user_id       String
  decision      String
  final_text    String?
  reason        String?
  created_at    DateTime @default(now())

  suggestion  Suggestion @relation(fields: [suggestion_id], references: [id])
  account     Account    @relation(fields: [workspace_id], references: [id])
  user        User       @relation(fields: [user_id], references: [id])

  @@schema("core")
}

model OwnerSettings {
  workspace_id              String   @id
  mode                      String   @default("OBSERVE_ONLY")
  aggressiveness            String   @default("CONSERVATIVE")
  enable_intents            String   @default("{}")
  min_intent_confidence     Float    @default(0.7)
  platforms_enabled         String   @default("[]")
  max_suggestions_per_day   Int      @default(20)
  automation_opt_in         Boolean  @default(false)
  max_suggestions_per_video Int      @default(2)
  cooldown_hours            Int      @default(24)
  preferred_language        String?
  tone                      String?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  account Account @relation(fields: [workspace_id], references: [id])

  @@index([workspace_id])
  @@schema("core")
}

model InstallRegistry {
  id             String   @id @default(uuid())
  install_id     String   @unique
  install_secret String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  account_id String?
  account    Account? @relation(fields: [account_id], references: [id])

  @@index([account_id])
  @@schema("core")
}

model EngagementEvent {
  id                 String   @id @default(uuid())
  external_event_id  String?  @unique
  dedup_key          String   @unique
  semantic_dedup_key String?  @unique
  observed_at        DateTime?
  platform           String
  target_id          String   @default("unknown")

  account_id String?
  account    Account? @relation(fields: [account_id], references: [id])
  install_id String?

  video_id     String?
  comment_id   String?
  content_text String?
  metadata     Json
  status       String
  failure_reason String? // Phase 28.2: Lossless Ingestion Reason
  created_at   DateTime @default(now())

  sessions     SuggestionSession[]
  suggestions  Suggestion[]
  leads        LeadOpportunity[]

  brand_id     String
  brand        Brand    @relation(fields: [brand_id], references: [id])

  @@index([account_id])
  @@index([install_id])
  @@index([created_at])
  @@index([brand_id])
  @@index([account_id, platform, video_id, created_at])
  @@schema("core")
}

model SuggestionSession {
  id              String   @id @default(uuid())
  event_id        String
  version         Int      @default(1)
  input_snapshot  String
  suggestion_text String
  brain_meta      String?
  created_at      DateTime @default(now())

  event    EngagementEvent @relation(fields: [event_id], references: [id])
  feedback FeedbackSignal?

  @@schema("core")
}

model FeedbackSignal {
  id             String   @id @default(uuid())
  session_id     String   @unique
  action         String
  final_text     String?
  edit_distance  Int?
  time_to_action Int?
  created_at     DateTime @default(now())

  session SuggestionSession @relation(fields: [session_id], references: [id])

  @@schema("core")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password_hash String
  status         String   @default("ACTIVE")
  created_at     DateTime @default(now())
  email_verified_at DateTime?
  verification_email_sent_at DateTime?

  login_attempts Int      @default(0)
  locked_until   DateTime?
  last_login_at  DateTime?

  memberships WorkspaceMembership[]
  sessions    Session[]
  decisions   SuggestionDecision[]
  action_tokens UserActionToken[]

  @@schema("core")
}

model UserActionToken {
  id          String   @id @default(uuid())
  user_id     String
  token_hash  String   @unique
  token_type  String
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime @default(now())
  metadata    Json     @default("{}")

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, token_type, expires_at])
  @@schema("core")
}

model AdminUser {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          String   @default("SUPERADMIN")
  created_at    DateTime @default(now())

  sessions AdminSession[]

  @@schema("core")
}

model AdminSession {
  id         String   @id @default(uuid())
  admin_id  String
  expires_at DateTime
  created_at DateTime @default(now())

  admin AdminUser @relation(fields: [admin_id], references: [id])

  @@schema("core")
}

model AuditLog {
  id             String   @id @default(uuid())
  actor_id       String
  actor_type     String
  action         String
  resource       String
  resource_id    String?
  workspace_id   String?
  meta           String?
  ip             String?
  correlation_id String?
  created_at     DateTime @default(now())

  @@index([workspace_id, created_at])
  @@index([actor_id, created_at])
  @@index([correlation_id])
  @@schema("core")
}

model WorkspaceMembership {
  id           String   @id @default(uuid())
  workspace_id String
  user_id      String
  role         String   @default("MEMBER")
  status       String   @default("ACTIVE")
  created_at   DateTime @default(now())

  account Account @relation(fields: [workspace_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@index([workspace_id])
  @@index([user_id])
  @@unique([workspace_id, user_id])
  @@schema("core")
}

model Session {
  id                  String   @id @default(uuid())
  user_id             String
  active_workspace_id String?
  expires_at          DateTime
  last_seen_at        DateTime @default(now())
  created_at          DateTime @default(now())

  user             User     @relation(fields: [user_id], references: [id])
  active_workspace Account? @relation(fields: [active_workspace_id], references: [id])

  @@index([user_id])
  @@index([active_workspace_id])
  @@schema("core")
}

enum BuyerStage {
  AWARENESS
  EVALUATING
  READY

  @@schema("core")
}

enum RecommendedAction {
  SILENT_CAPTURE
  RECOMMEND_DM
  PRIORITY_DM

  @@schema("core")
}

model LeadOpportunity {
  id                String            @id @default(uuid())
  platform          String
  video_id          String
  comment_id        String
  user_handle       String?
  user_profile_url  String?
  intent            String
  buyer_stage       BuyerStage
  confidence        Float
  preferences       Json?
  recommended_action RecommendedAction
  urgency_score     Float             @default(0.0)
  risk_level        String            @default("LOW") // LOW, MEDIUM, HIGH
  source_event_id   String
  account_id        String

  created_at        DateTime          @default(now())

  event             EngagementEvent   @relation(fields: [source_event_id], references: [id])
  account           Account           @relation(fields: [account_id], references: [id])
  drafts            OutreachDraft[]

  brand_id          String
  brand             Brand             @relation(fields: [brand_id], references: [id])

  // Phase 37.5: Market Profile Snapshot
  market_profile_id      String?
  market_profile_version Int?
  market_match_score     Float?
  market_match_reasons   Json? // String[] of reasons

  @@unique([platform, comment_id])
  @@index([brand_id])
  @@schema("core")
}

model OutreachDraft {
  id               String   @id @default(uuid())
  lead_id          String
  account_id       String
  platform         String
  buyer_stage      BuyerStage
  tone             String
  language         String
  draft_text       String
  edited_text      String?   // User edits before approval/send
  generation_meta  Json      // AI context
  
  // Phase 37.4: Lifecycle & Audit
  status              String    @default("DRAFT") // DRAFT, EDITED, APPROVED, SENT, REJECTED
  generated_by        String    @default("AI_CORE")
  confidence          Float?
  
  normalization_version String?
  intent_score          Float?

  approved_by_user_id String?
  approved_at         DateTime?
  sent_at             DateTime?

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt @default(now())

  lead LeadOpportunity @relation(fields: [lead_id], references: [id])
  brand Brand          @relation(fields: [brand_id], references: [id])
  brand_id String

  @@index([account_id, created_at])
  @@index([lead_id])
  @@index([brand_id])
  @@schema("core")
}

model ManualSendEvent {
  id                String   @id @default(uuid())
  
  draft_id          String
  lead_id           String
  brand_id          String
  
  sent_text         String   // Canonical Truth (Immutable)
  sent_by_user_id   String
  sent_at           DateTime @default(now())
  
  platform          String
  send_mode         String   // COPY_PASTE, PLATFORM_UI, OTHER
  confirmation_ack  Boolean  @default(false)
  
  notes             String?
  created_at        DateTime @default(now())

  @@index([brand_id])
  @@index([draft_id])
  @@index([sent_by_user_id])
  @@schema("core")
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
  
  @@schema("core")
}

enum PolicyMode {
  SAFE
  BALANCED
  AGGRESSIVE
  
  @@schema("core")
}

model AutomationPolicy {
  id              String       @id @default(uuid())
  brand_id        String
  status          PolicyStatus @default(DRAFT)
  version         Int          @default(1)
  mode            PolicyMode   @default(SAFE)
  enabled         Boolean      @default(false)
  
  // Gates
  relevance_min_score     Int  @default(70)
  intent_min_score        Int  @default(60)
  allow_capture_seen_events Boolean @default(true)
  
  // Rate Limits
  max_videos_per_hour      Int  @default(20)
  max_comments_per_video   Int  @default(30)
  max_comments_per_hour    Int  @default(200)
  max_leads_per_day        Int  @default(30)
  
  // Pacing
  cooldown_ms_between_actions Int @default(2500)
  random_jitter_ms            Int @default(1500)
  
  // Advanced
  platform_limits Json @default("{}")
  quiet_hours     Json @default("{}")
  notes           String?
  
  created_at      DateTime @default(now())
  created_by      String?
  updated_at      DateTime @updatedAt
  
  brand           Brand    @relation(fields: [brand_id], references: [id])
  runs            AutomationRun[]

  @@unique([brand_id, version])
  @@index([brand_id, status])
  @@schema("core")
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  DEGRADED  // WF-3.1: Completed but encountered ERROR decisions
  ABORTED
  FAILED

  @@schema("core")
}

model AutomationRun {
  id              String    @id @default(uuid())
  brand_id        String
  install_id      String
  platform        String
  discovery_mode  DiscoveryMode   @default(MANUAL_URL)
  discovery_intent DiscoveryIntent @default(BALANCED)
  
  status          RunStatus @default(RUNNING)
  started_at      DateTime  @default(now())
  ended_at        DateTime?
  
  policy_id       String?
  policy_snapshot Json
  market_profile_snapshot Json?  // WF-1: Added for reproducible automation
  stats           Json     @default("{}")
  abort_reason    String?
  claimed_by      String?
  claim_token     String?
  claimed_at      DateTime?
  heartbeat_at    DateTime?
  lease_expires_at DateTime?
  attempt_count   Int      @default(0)
  next_retry_at   DateTime?
  last_error      String?
  
  policy          AutomationPolicy? @relation(fields: [policy_id], references: [id])
  discovered_videos DiscoveredVideo[]
  
  @@index([brand_id])
  @@index([install_id])
  @@index([status, started_at])
  @@index([status, lease_expires_at])
  @@index([status, next_retry_at])
  @@index([claimed_by])
  @@schema("core")
}

// =====================================
// PHASE 37.5: Market Profile & Discovery
// =====================================

enum MarketCategory {
  SKINCARE
  BEAUTY
  FITNESS
  SAAS
  EDUCATION
  LOCAL_SERVICE
  ECOM_GENERAL

  @@schema("core")
}

enum MarketDecision {
  ACCEPT
  REJECT
  SKIP

  @@schema("core")
}

enum MarketSkipReason {
  LOW_SCORE
  AMBIGUOUS
  LANGUAGE_MISMATCH
  INSUFFICIENT_SIGNALS

  @@schema("core")
}

enum DiscoveryIntent {
  CONSERVATIVE
  BALANCED
  AGGRESSIVE

  @@schema("core")
}

enum MarketProfileStatus {
  DRAFT
  READY
  ACTIVE

  @@schema("core")
}

enum DiscoveryMode {
  MANUAL_URL
  FEED_SCROLL
  SEARCH_QUERY

  @@schema("core")
}

model MarketProfile {
  id                String            @id @default(uuid())
  brand_id          String
  name              String
  version           Int               @default(1)
  status            MarketProfileStatus @default(DRAFT)
  
  primary_category  MarketCategory
  target_audience   String
  languages         String[]
  
  // Keywords & Hashtags
  keywords_positive String[]
  keywords_negative String[]
  hashtags_positive String[]
  hashtags_negative String[]
  excluded_topics   String[]
  
  // Scoring Config
  acceptance_threshold Float          @default(0.6)
  weight_keyword       Float          @default(0.3)
  weight_hashtag       Float          @default(0.2)
  
  // Quality & Safety
  quality_score        Float          @default(0.0)
  validation_warnings  String[]
  
  discovery_intent     DiscoveryIntent @default(BALANCED)
  is_active            Boolean         @default(false)
  
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  brand                Brand           @relation(fields: [brand_id], references: [id])

  @@index([brand_id, is_active])
  @@schema("core")
}

enum VideoDiscoveryDecision {
  ACCEPT
  REJECT
  SKIP
  ERROR  // WF-3.1: System/operational failure (not business decision)

  @@schema("core")
}

model DiscoveredVideo {
  id                    String                 @id @default(uuid())
  automation_run_id     String
  brand_id              String
  platform              String
  video_id              String
  video_url             String
  market_profile_id     String?
  market_profile_version Int?
  market_score          Float                  @default(0.0)
  decision              VideoDiscoveryDecision
  decision_reasons      String[]
  
  // WF-3.1: Failure Semantics & Provenance
  evaluation_performed  Boolean @default(true)
  error_class           String?
  http_status           Int?
  
  discovered_at         DateTime               @default(now())

  // Relations
  run                   AutomationRun          @relation(fields: [automation_run_id], references: [id])
  brand                 Brand                  @relation(fields: [brand_id], references: [id])

  @@index([automation_run_id])
  @@index([brand_id, discovered_at])
  @@schema("core")
}
